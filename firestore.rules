rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isBootstrappedAdmin() {
      return isSignedIn() && (
        request.auth.token.email == "Pandit.Alap@gmail.com" ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidSchool(data) {
      return data.Sch_UDISE is string &&
             data.Sch_UDISE.size() <= 25 &&
             data.Sch_Name is string &&
             data.Sch_Name.size() <= 255;
    }

    // Schools Collection:
    // Read: Open to public for UDISE verification, student admission, and external programme registrations
    // Create, Update, Delete: Allowed for authenticated users and administrator
    match /schools/{schoolId} {
      allow read: if true;
      allow create, update: if isValidId(schoolId) && isValidSchool(request.resource.data);
      allow delete: if isSignedIn();
    }

    // Users Collection:
    // SMDb administrative accounts
    match /users/{userId} {
      allow read, write: if true;
    }
  }
}
